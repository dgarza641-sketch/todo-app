# Local database connection (Render supplies DATABASE_URL in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daylight

# Set this to your deployed URL, with no trailing slash.
APP_URL=http://localhost:3000
COOKIE_SECRET=replace-with-a-long-random-string

# Create an OAuth Web Application in Google Cloud and add:
# http://localhost:3000/auth/google/callback
# and https://YOUR-APP.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: enables email alerts. Leave blank to use in-app/browser alerts only.
RESEND_API_KEY=
ALERT_FROM=Daylight <alerts@example.com>
